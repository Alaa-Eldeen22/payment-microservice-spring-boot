# Database
DB_URL=jdbc:postgresql://localhost:5432/payment_service_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# Spring profile
SPRING_PROFILE=dev

# RabbitMQ
# exchange/queue/routing-key names are fixed by MESSAGING-CONTRACT.md, not configurable
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10
RABBITMQ_PUBLISH_TIMEOUT_MS=10000
# only override against a throw-away broker (queue args are immutable)
# RABBITMQ_RETRY_DELAYS_MS=5000,30000,120000

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Logging: set to "ecs" or "logstash" for one JSON object per line (includes MDC)
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
